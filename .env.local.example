# ---------------------------------------------------------------------------
# Beispiel-Umgebung. Kopiere diese Datei zu ".env.local" und trage echte Werte
# ein. ".env.local" ist per .gitignore ausgeschlossen und landet NIE im Repo.
# ---------------------------------------------------------------------------

# Vercel Blob: server-seitiges Lese/Schreib-Token.
# Bekommst du in den Vercel-Projekteinstellungen (Storage -> Blob -> Connect).
# Bleibt AUSSCHLIESSLICH serverseitig (nur in den API-Routen genutzt).
# Ist der Token NICHT gesetzt, nutzt die App automatisch den lokalen
# Datei-Fallback unter ./.data/data.json (nur fuer die Entwicklung).
BLOB_READ_WRITE_TOKEN=

# Optionaler Dateiname/Pfad der Blob-Datei (Standard: "gemeindeplaner/data.json").
# BLOB_DATA_PATH=gemeindeplaner/data.json

# Bei jedem Schreiben zusaetzlich eine versionierte Backup-Kopie im Blob ablegen
# (backups/data-<zeitstempel>.json). "true" zum Aktivieren.
# BLOB_KEEP_BACKUPS=true

# Zugriffsschutz (Shared Secret). Wird dieser Wert gesetzt, verlangen die
# API-Routen den passenden Code im Header "x-access-code". Die App fragt ihn
# einmal ab und merkt ihn lokal. Leer lassen = kein Schutz (nur lokal sinnvoll).
APP_ACCESS_CODE=
